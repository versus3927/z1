&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Объект.Ссылка.Пустая() Тогда
		Если Параметры.Свойство("ДатаНачала") И ЗначениеЗаполнено(Параметры.ДатаНачала) Тогда
			Объект.ДатаНачала = Параметры.ДатаНачала;
			Объект.Дата = Параметры.ДатаНачала;
		ИначеЕсли НЕ ЗначениеЗаполнено(Объект.ДатаНачала) Тогда
			Объект.ДатаНачала = ТекущаяДатаСеанса();
		КонецЕсли;

		Если Параметры.Свойство("ДатаОкончания") И ЗначениеЗаполнено(Параметры.ДатаОкончания) Тогда
			Объект.ДатаОкончания = Параметры.ДатаОкончания;
		ИначеЕсли НЕ ЗначениеЗаполнено(Объект.ДатаОкончания) Тогда
			Объект.ДатаОкончания = Объект.ДатаНачала + 3600;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	ОбновитьОбязательностьРезультата();
	ОбновитьДоступностьНапоминания();

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьТипВидаАктивностиНаСервере(ВидСсылка)

	Если ЗначениеЗаполнено(ВидСсылка) Тогда
		Возврат ОбщегоНазначенияКлиентСерверПовтИсп_ПолучитьТип(ВидСсылка);
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

&НаСервереБезКонтекста
Функция ОбщегоНазначенияКлиентСерверПовтИсп_ПолучитьТип(ВидСсылка)

	Возврат ВидСсылка.ТипАктивности;

КонецФункции

&НаКлиенте
Процедура ВидАктивностиПриИзменении(Элемент)

	// Автоматически проставляем тип активности (Онлайн / Офлайн) по выбранному виду активности
	Если ЗначениеЗаполнено(Объект.ВидАктивности) Тогда
		НовыйТип = ПолучитьТипВидаАктивностиНаСервере(Объект.ВидАктивности);
		Если ЗначениеЗаполнено(НовыйТип) Тогда
			Объект.ТипАктивности = НовыйТип;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВидАктивностиНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	// Если пользователь сначала выбрал Тип активности (Онлайн или Офлайн),
	// подставляем к выбору виды активности соответствующего типа;
	// если тип не выбран — доступны все виды активности и тип заполняется автоматически.
	Если ЗначениеЗаполнено(Объект.ТипАктивности) И НЕ ЗначениеЗаполнено(Объект.ВидАктивности) Тогда
		СтандартнаяОбработка = Ложь;
		ОтборФормы = Новый Структура("ТипАктивности", Объект.ТипАктивности);
		ПараметрыВыбора = Новый Структура("Отбор", ОтборФормы);
		ОткрытьФорму("Справочник.ВидыАктивностей.ФормаВыбора", ПараметрыВыбора, Элемент);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ТипАктивностиПриИзменении(Элемент)

	// Если выбран новый тип активности, а текущий вид активности относится к другому типу — очищаем вид для перевыбора
	Если ЗначениеЗаполнено(Объект.ТипАктивности) И ЗначениеЗаполнено(Объект.ВидАктивности) Тогда
		ТипВида = ПолучитьТипВидаАктивностиНаСервере(Объект.ВидАктивности);
		Если ЗначениеЗаполнено(ТипВида) И ТипВида <> Объект.ТипАктивности Тогда
			Объект.ВидАктивности = ПредопределенноеЗначение("Справочник.ВидыАктивностей.ПустаяСсылка");
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВыполненоПриИзменении(Элемент)

	ОбновитьОбязательностьРезультата();

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьОбязательностьРезультата()

	Элементы.РезультатПроведения.АвтоОтметкаНезаполненного = Объект.Выполнено;

КонецПроцедуры

&НаКлиенте
Процедура ДатаНачалаПриИзменении(Элемент)

	Если ЗначениеЗаполнено(Объект.ДатаНачала) Тогда
		Объект.Дата = Объект.ДатаНачала;
		Если НЕ ЗначениеЗаполнено(Объект.ДатаОкончания) Или Объект.ДатаОкончания < Объект.ДатаНачала Тогда
			Объект.ДатаОкончания = Объект.ДатаНачала + 3600;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура НапомнитьПриИзменении(Элемент)

	Если Объект.Напомнить И НЕ ЗначениеЗаполнено(Объект.ДатаВремяНапоминания) Тогда
		Если ЗначениеЗаполнено(Объект.ДатаНачала) Тогда
			Объект.ДатаВремяНапоминания = Объект.ДатаНачала - 3600;
		Иначе
			Объект.ДатаВремяНапоминания = ТекущаяДата() + 900;
		КонецЕсли;
	КонецЕсли;
	Объект.НапоминаниеВыполнено = Ложь;
	ОбновитьДоступностьНапоминания();

КонецПроцедуры

&НаКлиенте
Процедура ДатаВремяНапоминанияПриИзменении(Элемент)

	Объект.НапоминаниеВыполнено = Ложь;

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДоступностьНапоминания()

	Элементы.ДатаВремяНапоминания.Доступность = Объект.Напомнить;

КонецПроцедуры
