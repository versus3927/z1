Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	// Автоматическое определение типа активности по выбранному виду активности, если тип еще не проставлен
	Если ЗначениеЗаполнено(ВидАктивности) И НЕ ЗначениеЗаполнено(ТипАктивности) Тогда
		ТипАктивности = ВидАктивности.ТипАктивности;
	КонецЕсли;

	Если ЗначениеЗаполнено(ДатаНачала) И НЕ ЗначениеЗаполнено(Дата) Тогда
		Дата = ДатаНачала;
	КонецЕсли;

	Если ЗначениеЗаполнено(ДатаНачала) И ЗначениеЗаполнено(ДатаОкончания) И ДатаОкончания < ДатаНачала Тогда
		Сообщить("Дата и время окончания активности не могут быть раньше даты и времени начала!");
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	// Контроль по ТЗ (Функция 2): маркетинговую активность можно провести/сохранить
	// с признаком «Выполнено», только если заполнен «Результат проведения».
	Если Выполнено И ПустаяСтрока(РезультатПроведения) Тогда
		Сообщить("Нельзя установить признак «Выполнено» и провести маркетинговую активность без заполнения поля «Результат проведения»!");
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	Если Напомнить И НЕ ЗначениеЗаполнено(ДатаВремяНапоминания) Тогда
		Сообщить("Укажите дату и время напоминания для маркетинговой активности!");
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	Если НЕ Напомнить Тогда
		НапоминаниеВыполнено = Ложь;
	КонецЕсли;

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	// Дополнительный контроль при проведении документа
	Если Выполнено И ПустаяСтрока(РезультатПроведения) Тогда
		Сообщить("Проведение маркетинговой активности с признаком «Выполнено» невозможно: заполните поле «Результат проведения»!");
		Отказ = Истина;
		Возврат;
	КонецЕсли;

КонецПроцедуры

Процедура ПриЗаписи(Отказ)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	Если Напомнить И ЗначениеЗаполнено(ДатаВремяНапоминания) И НЕ НапоминаниеВыполнено Тогда
		Сообщить("Напоминание по активности «" + СокрЛП(Название) + "» установлено на "
			+ Формат(ДатаВремяНапоминания, "ДЛФ=DDT"));
	КонецЕсли;

КонецПроцедуры
