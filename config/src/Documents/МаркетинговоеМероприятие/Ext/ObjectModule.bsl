Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	Если ЗначениеЗаполнено(ДатаНачала) И НЕ ЗначениеЗаполнено(Дата) Тогда
		Дата = ДатаНачала;
	КонецЕсли;

	Если ЗначениеЗаполнено(ДатаНачала) И ЗначениеЗаполнено(ДатаОкончания) И ДатаОкончания < ДатаНачала Тогда
		Сообщить("Дата и время окончания мероприятия не могут быть раньше даты и времени начала!");
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	Если Напомнить И НЕ ЗначениеЗаполнено(ДатаВремяНапоминания) Тогда
		Сообщить("Укажите дату и время напоминания для маркетингового мероприятия!");
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	Если НЕ Напомнить Тогда
		НапоминаниеВыполнено = Ложь;
	КонецЕсли;

КонецПроцедуры

Процедура ПриЗаписи(Отказ)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	Если Напомнить И ЗначениеЗаполнено(ДатаВремяНапоминания) И НЕ НапоминаниеВыполнено Тогда
		Сообщить("Напоминание по мероприятию «" + СокрЛП(Название) + "» установлено на "
			+ Формат(ДатаВремяНапоминания, "ДЛФ=DDT"));
	КонецЕсли;

КонецПроцедуры
