Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	// Суммы строк и итог по документу рассчитываются всегда, в том числе
	// при программном создании документа из карточки сделки.
	Итог = 0;
	Для Каждого СтрокаТовары Из Товары Цикл
		СтрокаТовары.Сумма = СтрокаТовары.Количество * СтрокаТовары.Цена;
		Итог = Итог + СтрокаТовары.Сумма;
	КонецЦикла;
	ОбщаяСтоимость = Итог;

	// Если товары не заполнены, а документ создаётся из сделки,
	// в качестве суммы берём ожидаемую сумму сделки.
	Если Итог = 0 И ЗначениеЗаполнено(Сделка) Тогда
		ОбщаяСтоимость = Сделка.ОжидаемаяСумма;
	КонецЕсли;

	// Связь с клиентом: если не указан, подставляем из сделки.
	Если НЕ ЗначениеЗаполнено(Клиент) И ЗначениеЗаполнено(Сделка) Тогда
		Клиент = Сделка.Клиент;
	КонецЕсли;

КонецПроцедуры
