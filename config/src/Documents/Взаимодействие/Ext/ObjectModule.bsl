Процедура ПриЗаписи(Отказ)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	// Удаляем прежнее напоминание этого взаимодействия, чтобы не было дублей
	НапоминанияПользователя.УдалитьНапоминание(Ссылка);

	Если Напомнить И ЗначениеЗаполнено(ДатаВремяНапоминания)
		И ДатаВремяНапоминания > ТекущаяДатаСеанса() Тогда

		Напоминание = НапоминанияПользователя.СоздатьНапоминание();
		Напоминание.Описание = Строка(Клиент) + " — " + Строка(ВидВзаимодействия);
		Напоминание.ВремяНапоминания = ДатаВремяНапоминания;
		Напоминание.Источник = Ссылка;
		Напоминание.Записать();

	КонецЕсли;

КонецПроцедуры