#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Заполнение нового взаимодействия параметрами,
	// переданными кнопкой «Запланировать взаимодействие»
	Если Объект.Ссылка.Пустая() Тогда
		Если Параметры.Свойство("Клиент") Тогда
			Объект.Клиент = Параметры.Клиент;
		КонецЕсли;
		Если Параметры.Свойство("КонтактноеЛицо") Тогда
			Объект.КонтактноеЛицо = Параметры.КонтактноеЛицо;
		КонецЕсли;
		Если Параметры.Свойство("ИсходноеВзаимодействие") Тогда
			ИсходноеВзаимодействие = Параметры.ИсходноеВзаимодействие;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	ОбновитьВидимостьСледующегоШага();

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)

	// Следующее взаимодействие записано из дочерней формы — перечитываем объект
	Если ИмяСобытия = "ЗаписаноСледующееВзаимодействие" Тогда
		Прочитать();
		ОбновитьВидимостьСледующегоШага();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	// Если форма открыта кнопкой «Запланировать взаимодействие» —
	// проставляем ссылку на это взаимодействие в исходном документе
	Если ЗначениеЗаполнено(ИсходноеВзаимодействие) Тогда
		ИсходныйОбъект = ИсходноеВзаимодействие.ПолучитьОбъект();
		ИсходныйОбъект.СледующееВзаимодействие = ТекущийОбъект.Ссылка;
		ИсходныйОбъект.Записать();
		ИсходноеВзаимодействие = Неопределено;
		Связано = Истина;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)

	Если Связано Тогда
		Связано = Ложь;
		Оповестить("ЗаписаноСледующееВзаимодействие");
	КонецЕсли;
	ОбновитьВидимостьСледующегоШага();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗапланироватьВзаимодействие(Команда)

	// Текущее взаимодействие должно быть записано,
	// чтобы на него можно было сослаться
	Если Объект.Ссылка.Пустая() Или Модифицированность Тогда
		Если Не Записать() Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Клиент", Объект.Клиент);
	ПараметрыФормы.Вставить("КонтактноеЛицо", Объект.КонтактноеЛицо);
	ПараметрыФормы.Вставить("ИсходноеВзаимодействие", Объект.Ссылка);

	ОткрытьФорму("Документ.Взаимодействие.Форма.ФормаДокумента",
		ПараметрыФормы, ЭтотОбъект);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ОбновитьВидимостьСледующегоШага()

	Запланировано = ЗначениеЗаполнено(Объект.СледующееВзаимодействие);

	Элементы.НадписьНеЗапланировано.Видимость = Не Запланировано;
	Элементы.ЗапланироватьВзаимодействие.Видимость = Не Запланировано;
	Элементы.СледующееВзаимодействие.Видимость = Запланировано;

КонецПроцедуры

#КонецОбласти