Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	// Дата оплаты по умолчанию — текущая дата.
	Если НЕ ЗначениеЗаполнено(ДатаОплаты) Тогда
		ДатаОплаты = ТекущаяДатаСеанса();
	КонецЕсли;

	// Если оплата вносится по заказу, подставляем клиента и сделку из заказа,
	// а сумму оплаты по умолчанию берём равной сумме заказа.
	Если ЗначениеЗаполнено(ЗаказКлиента) Тогда
		Если НЕ ЗначениеЗаполнено(Клиент) Тогда
			Клиент = ЗаказКлиента.Клиент;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Сделка) Тогда
			Сделка = ЗаказКлиента.Сделка;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(СуммаОплаты) Тогда
			СуммаОплаты = ЗаказКлиента.ОбщаяСтоимость;
		КонецЕсли;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(СуммаОплаты) Тогда
		Сообщить("Укажите сумму оплаты.");
		Отказ = Истина;
	КонецЕсли;

КонецПроцедуры
