Процедура ПриНачалеРаботыСистемы()

	// Проверяем наступившие напоминания сразу при старте и далее каждые 30 секунд
	ПроверитьНапоминанияМаркетинга();
	ПроверитьНапоминанияВзаимодействий();
	ПодключитьОбработчикОжидания("ПроверитьНапоминанияМаркетинга", 30);
	ПодключитьОбработчикОжидания("ПроверитьНапоминанияВзаимодействий", 30);

КонецПроцедуры

Процедура ПроверитьНапоминанияМаркетинга() Экспорт

	Актуальные = НапоминанияМаркетингаВызовСервера.ПолучитьАктуальныеНапоминания(Истина);
	Если Актуальные.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Нап Из Актуальные Цикл
		ТекстОповещения = Нап.ВидОбъекта + ": " + Нап.Название
			+ " (начало: " + Формат(Нап.ДатаНачала, "ДЛФ=DDT") + ")";
		ПоказатьОповещениеПользователя(
			"Напоминание маркетинга",
			ПолучитьНавигационнуюСсылку(Нап.ОбъектНапоминания),
			ТекстОповещения);
	КонецЦикла;

	ПараметрыФормы = Новый Структура("ТолькоНаступившие", Истина);
	ОткрытьФорму("Обработка.НапоминанияМаркетинга.Форма.Форма", ПараметрыФормы, , "НапоминанияМаркетингаАктивные");

КонецПроцедуры

Процедура ПроверитьНапоминанияВзаимодействий() Экспорт

	Актуальные = НапоминанияВзаимодействийВызовСервера.ПолучитьАктуальныеНапоминания(Истина);
	Для Каждого Нап Из Актуальные Цикл
		ПоказатьОповещениеПользователя(
			"Напоминание о взаимодействии",
			ПолучитьНавигационнуюСсылку(Нап.ОбъектНапоминания),
			НапоминанияВзаимодействийВызовСервера.ТекстНапоминания(Нап));
	КонецЦикла;

КонецПроцедуры
