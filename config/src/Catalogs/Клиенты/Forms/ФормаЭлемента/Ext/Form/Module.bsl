&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ЗаполнитьИсторию();

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьИсторию()

	ИсторияВзаимодействий.Очистить();

	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Вз.Ссылка КАК Ссылка,
		|	Вз.Дата КАК Дата,
		|	Вз.ВидВзаимодействия КАК Вид,
		|	Вз.КраткоеСодержание КАК Содержание,
		|	Вз.ДостигнутыйРезультат КАК Результат,
		|	Вз.КонтактноеЛицо КАК КонтактноеЛицо,
		|	Вз.СледующееВзаимодействие КАК СледующийШаг
		|ИЗ
		|	Документ.Взаимодействие КАК Вз
		|ГДЕ
		|	Вз.Клиент = &Клиент
		|	И НЕ Вз.ПометкаУдаления
		|УПОРЯДОЧИТЬ ПО
		|	Вз.Дата УБЫВ";

	Запрос.УстановитьПараметр("Клиент", Объект.Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
		Стр = ИсторияВзаимодействий.Добавить();
		Стр.Ссылка = Строка(Выборка.Ссылка);
		Стр.Дата = Выборка.Дата;
		Стр.Вид = Строка(Выборка.Вид);
		Стр.Содержание = Выборка.Содержание;
		Стр.Результат = Строка(Выборка.Результат);
		Стр.КонтактноеЛицо = Строка(Выборка.КонтактноеЛицо);
		Стр.СледующийШаг = ?(ЗначениеЗаполнено(Выборка.СледующийШаг), "Запланировано", "Не запланировано");
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьИсторию(Команда)

	ЗаполнитьИсторию();

КонецПроцедуры

&НаКлиенте
Процедура СоздатьВзаимодействие(Команда)

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Клиент", Объект.Ссылка);
	ОткрытьФорму("Документ.Взаимодействие.Форма.ФормаДокумента", ПараметрыФормы, ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура ИсторияВыбор(Элемент, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ТекДанные = Элементы.ИсторияВзаимодействий.ТекущиеДанные;
	Если ТекДанные <> Неопределено И ЗначениеЗаполнено(ТекДанные.Ссылка) Тогда
		ОткрытьВзаимодействиеПоСсылке(ТекДанные.Ссылка);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ОткрытьВзаимодействиеПоСсылке(ТекстСсылки)

	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Документ.Взаимодействие ГДЕ Строка(Ссылка) = &Текст");
	Запрос.УстановитьПараметр("Текст", ТекстСсылки);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ПоказатьЗначение(, Выборка.Ссылка);
	КонецЕсли;

КонецПроцедуры
