Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	// Наименование проверяется платформой автоматически.
	// Дополнительно контролируем, что у клиента есть телефон и e-mail:
	// достаточно заполнить основные поля карточки либо указать контакты
	// в табличной части «Контакты» (их может быть несколько).

	ЕстьТелефон = ЗначениеЗаполнено(Телефон);
	ЕстьПочта = ЗначениеЗаполнено(Email);

	Для Каждого СтрокаКИ Из Контакты Цикл
		Если СтрокаКИ.Тип = Перечисления.ТипыКонтакта.Телефон
			И ЗначениеЗаполнено(СтрокаКИ.Значение) Тогда
			ЕстьТелефон = Истина;
		ИначеЕсли СтрокаКИ.Тип = Перечисления.ТипыКонтакта.Email
			И ЗначениеЗаполнено(СтрокаКИ.Значение) Тогда
			ЕстьПочта = Истина;
		КонецЕсли;
	КонецЦикла;

	Если Не ЕстьТелефон Тогда
		Сообщить("Укажите телефон клиента: заполните поле «Телефон» или добавьте контакт с типом «Телефон»!");
		Отказ = Истина;
	КонецЕсли;

	Если Не ЕстьПочта Тогда
		Сообщить("Укажите e-mail клиента: заполните поле «E-mail» или добавьте контакт с типом «Email»!");
		Отказ = Истина;
	КонецЕсли;

КонецПроцедуры
