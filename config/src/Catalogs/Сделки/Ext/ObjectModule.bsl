Процедура ПередЗаписью(Отказ)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	// Фиксация перехода на новый этап
	Если ЗначениеЗаполнено(ТекущийЭтап) Тогда
		// Проверяем, не записан ли уже этот этап
		УжеЕсть = Ложь;
		Для Каждого Стр Из ИсторияЭтапов Цикл
			Если Стр.Этап = ТекущийЭтап И Стр.Статус = Статус Тогда
				УжеЕсть = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Не УжеЕсть Тогда
			НоваяСтрока = ИсторияЭтапов.Добавить();
			НоваяСтрока.Этап = ТекущийЭтап;
			НоваяСтрока.ДатаПерехода = ТекущаяДатаСеанса();
			НоваяСтрока.Статус = Статус;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры
