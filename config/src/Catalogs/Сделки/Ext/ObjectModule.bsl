Процедура ПередЗаписью(Отказ)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	// Проигранная сделка обязательно должна иметь причину проигрыша
	Если Статус = Перечисления.СтатусыСделок.Проиграна И НЕ ЗначениеЗаполнено(ПричинаПроигрыша) Тогда
		Сообщить("Для проигранной сделки укажите причину проигрыша!");
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	// Фиксация перехода на новый этап: дата перехода и длительность
	Если ЗначениеЗаполнено(ТекущийЭтап) Тогда
		УжеЕсть = Ложь;
		Для Каждого Стр Из ИсторияЭтапов Цикл
			Если Стр.Этап = ТекущийЭтап И Стр.Статус = Статус Тогда
				УжеЕсть = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Не УжеЕсть Тогда
			ПредыдущаяДата = НачалоДня(ДатаСоздания);
			Если ИсторияЭтапов.Количество() > 0 Тогда
				ПредыдущаяДата = ИсторияЭтапов[ИсторияЭтапов.Количество() - 1].ДатаПерехода;
			КонецЕсли;
			СтрокаИстории = ИсторияЭтапов.Добавить();
			СтрокаИстории.Этап = ТекущийЭтап;
			СтрокаИстории.ДатаПерехода = ТекущаяДатаСеанса();
			СтрокаИстории.Статус = Статус;
			СтрокаИстории.Длительность = Окр((СтрокаИстории.ДатаПерехода - ПредыдущаяДата) / 3600, 2);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)

	ИсторияЭтапов.Очистить();

КонецПроцедуры
