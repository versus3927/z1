&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	УстановитьВидимость();
	ЗаполнитьДокументыСделки();
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	УстановитьВидимость();
КонецПроцедуры

&НаКлиенте
Процедура СтатусПриИзменении(Элемент)
	УстановитьВидимость();
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимость()
	Элементы.ПричинаПроигрыша.Видимость = (Объект.Статус = ПредопределенноеЗначение("Перечисление.СтатусыСделок.Проиграна"));
	Если Элементы.ПричинаПроигрыша.Видимость Тогда
		Элементы.ПричинаПроигрыша.АвтоОтметкаНезаполненного = Истина;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПерейтиНаСледующийЭтап(Команда)

	Результат = ПерейтиНаСледующийЭтапНаСервере();
	Если Результат.Успех Тогда
		ВосстановитьЗначения(Результат.Значения);
		ОбновитьДокументы();
	Иначе
		Сообщить(Результат.Сообщение);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ПерейтиНаСледующийЭтапНаСервере()

	Результат = Новый Структура("Успех, Сообщение, Значения", Ложь, "", Новый Структура);

	Если ЗначениеЗаполнено(Объект.Статус) = Ложь Тогда
		Результат.Сообщение = "Перед переходом на следующий этап укажите статус сделки.";
		Возврат Результат;
	КонецЕсли;

	ТекущийЭтап = ?(ЗначениеЗаполнено(Объект.ТекущийЭтап), Объект.ТекущийЭтап, Перечисления.ЭтапыСделки.ПолученаЗаявка);
	СледующийЭтап = СледующийЭтапДля(ТекущийЭтап);

	Если СледующийЭтап = Неопределено Тогда
		Результат.Сообщение = "Сделка уже находится на последнем этапе «" + Строка(ТекущийЭтап) + "».";
		Возврат Результат;
	КонецЕсли;

	ЗаписатьСтрокуИстории(ТекущийЭтап);
	Объект.ТекущийЭтап = СледующийЭтап;
	Объект.Записать();

	Результат.Успех = Истина;
	Результат.Значения = Новый Структура("Объект, ИсторияЭтапов", Объект, Объект.ИсторияЭтапов);
	Возврат Результат;

КонецФункции

&НаСервере
Функция СледующийЭтапДля(ТекущийЭтап)

	Если ТекущийЭтап = Перечисления.ЭтапыСделки.ПолученаЗаявка Тогда
		Возврат Перечисления.ЭтапыСделки.КлиентЗарегистрирован;
	ИначеЕсли ТекущийЭтап = Перечисления.ЭтапыСделки.КлиентЗарегистрирован Тогда
		Возврат Перечисления.ЭтапыСделки.ВыявленаПотребность;
	ИначеЕсли ТекущийЭтап = Перечисления.ЭтапыСделки.ВыявленаПотребность Тогда
		Возврат Перечисления.ЭтапыСделки.КоммерческоеПредложение;
	ИначеЕсли ТекущийЭтап = Перечисления.ЭтапыСделки.КоммерческоеПредложение Тогда
		Возврат Перечисления.ЭтапыСделки.ЗаключенДоговор;
	ИначеЕсли ТекущийЭтап = Перечисления.ЭтапыСделки.ЗаключенДоговор Тогда
		Возврат Перечисления.ЭтапыСделки.ВыставленСчет;
	ИначеЕсли ТекущийЭтап = Перечисления.ЭтапыСделки.ВыставленСчет Тогда
		Возврат Перечисления.ЭтапыСделки.ПолученаОплата;
	ИначеЕсли ТекущийЭтап = Перечисления.ЭтапыСделки.ПолученаОплата Тогда
		Возврат Перечисления.ЭтапыСделки.Продажа;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

&НаСервере
Процедура ЗаписатьСтрокуИстории(Этап)

	Стр = Объект.ИсторияЭтапов.Добавить();
	Стр.Этап = Этап;
	Стр.ДатаПерехода = ТекущаяДатаСеанса();
	Стр.Статус = Объект.Статус;

КонецПроцедуры

&НаКлиенте
Процедура СоздатьДокумент(Команда)

	Результат = СоздатьДокументПоЭтапуНаСервере();
	Если Результат.Успех Тогда
		Если ЗначениеЗаполнено(Результат.Ссылка) Тогда
			ПоказатьЗначение(, Результат.Ссылка);
		КонецЕсли;
		ОбновитьДокументы();
	Иначе
		Сообщить(Результат.Сообщение);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция СоздатьДокументПоЭтапуНаСервере()

	Результат = Новый Структура("Успех, Сообщение, Ссылка", Ложь, "", Неопределено);

	Если Не ЗначениеЗаполнено(Объект.ТекущийЭтап) Тогда
		Результат.Сообщение = "Сначала укажите текущий этап сделки.";
		Возврат Результат;
	КонецЕсли;

	Этап = Объект.ТекущийЭтап;
	Документ = Неопределено;

	Если Этап = Перечисления.ЭтапыСделки.КоммерческоеПредложение Тогда
		Документ = Документы.КоммерческоеПредложение.СоздатьДокумент();
	ИначеЕсли Этап = Перечисления.ЭтапыСделки.ВыставленСчет Тогда
		Документ = Документы.ЗаказКлиента.СоздатьДокумент();
	ИначеЕсли Этап = Перечисления.ЭтапыСделки.ПолученаОплата Тогда
		Документ = Документы.ПоступлениеДС.СоздатьДокумент();
	ИначеЕсли Этап = Перечисления.ЭтапыСделки.Продажа Тогда
		Документ = Документы.Продажа.СоздатьДокумент();
	КонецЕсли;

	Если Документ = Неопределено Тогда
		Результат.Сообщение = "Для этапа «" + Строка(Этап) + "» документ не предусмотрен.";
		Возврат Результат;
	КонецЕсли;

	Документ.Дата = ТекущаяДатаСеанса();
	Документ.Клиент = Объект.Клиент;
	Документ.Сделка = Объект.Ссылка;

	Документ.Записать(РежимЗаписиДокумента.Запись);

	Результат.Успех = Истина;
	Результат.Ссылка = Документ.Ссылка;
	Возврат Результат;

КонецФункции

&НаКлиенте
Процедура ОбновитьДокументы(Команда)

	ЗаполнитьДокументыСделки();

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДокументыСделки()

	ДокументыСделки.Очистить();
	ДокументыСделкиСсылка.Очистить();

	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	""Коммерческое предложение"" КАК Вид,
		|	Док.Дата КАК Дата,
		|	Док.Номер КАК Номер,
		|	Док.ОбщаяСтоимость КАК Сумма
		|ИЗ
		|	Документ.КоммерческоеПредложение КАК Док
		|ГДЕ
		|	Док.Сделка = &Сделка
		|	И НЕ Док.ПометкаУдаления
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	""Заказ клиента"",
		|	Док.Дата,
		|	Док.Номер,
		|	Док.ОбщаяСтоимость
		|ИЗ
		|	Документ.ЗаказКлиента КАК Док
		|ГДЕ
		|	Док.Сделка = &Сделка
		|	И НЕ Док.ПометкаУдаления
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	""Продажа"",
		|	Док.Дата,
		|	Док.Номер,
		|	Док.ОбщаяСтоимость
		|ИЗ
		|	Документ.Продажа КАК Док
		|ГДЕ
		|	Док.Сделка = &Сделка
		|	И НЕ Док.ПометкаУдаления
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	""Поступление денежных средств"",
		|	Док.Дата,
		|	Док.Номер,
		|	Док.СуммаОплаты
		|ИЗ
		|	Документ.ПоступлениеДС КАК Док
		|ГДЕ
		|	Док.Сделка = &Сделка
		|	И НЕ Док.ПометкаУдаления
		|
		|УПОРЯДОЧИТЬ ПО
		|	Дата";

	Запрос.УстановитьПараметр("Сделка", Объект.Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
		Стр = ДокументыСделки.Добавить();
		Стр.Вид = Выборка.Вид;
		Стр.Дата = Выборка.Дата;
		Стр.Номер = Выборка.Номер;
		Стр.Сумма = Выборка.Сумма;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ДокументыСделкиВыбор(Элемент, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ТекДанные = Элементы.ДокументыСделки.ТекущиеДанные;
	Если ТекДанные <> Неопределено Тогда
		ОткрытьДокументПоСделке(ТекДанные.Вид, ТекДанные.Номер);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ОткрытьДокументПоСделке(ВидДокумента, НомерДокумента)

	Если ВидДокумента = "Коммерческое предложение" Тогда
		Ссылка = НайтиДокумент(Документы.КоммерческоеПредложение, НомерДокумента);
	ИначеЕсли ВидДокумента = "Заказ клиента" Тогда
		Ссылка = НайтиДокумент(Документы.ЗаказКлиента, НомерДокумента);
	ИначеЕсли ВидДокумента = "Продажа" Тогда
		Ссылка = НайтиДокумент(Документы.Продажа, НомерДокумента);
	ИначеЕсли ВидДокумента = "Поступление денежных средств" Тогда
		Ссылка = НайтиДокумент(Документы.ПоступлениеДС, НомерДокумента);
	Иначе
		Возврат;
	КонецЕсли;

	Если ЗначениеЗаполнено(Ссылка) Тогда
		ПоказатьЗначение(, Ссылка);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция НайтиДокумент(МенеджерДокумента, НомерДокумента)

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ " + МенеджерДокумента + " ГДЕ Номер = &Номер И Сделка = &Сделка";
	Запрос.УстановитьПараметр("Номер", НомерДокумента);
	Запрос.УстановитьПараметр("Сделка", Объект.Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Неопределено;

КонецФункции
