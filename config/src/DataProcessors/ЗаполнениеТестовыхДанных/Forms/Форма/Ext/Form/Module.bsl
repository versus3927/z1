&НаСервере
Процедура ЗаполнитьДанныеНаСервере()
	// Создаем товары
	Т1 = Справочники.Товары.СоздатьЭлемент(); Т1.Наименование = "Холодильник"; Т1.Записать();
	Т2 = Справочники.Товары.СоздатьЭлемент(); Т2.Наименование = "Стиральная машина"; Т2.Записать();
	Т3 = Справочники.Товары.СоздатьЭлемент(); Т3.Наименование = "Микроволновка"; Т3.Записать();
	
	// Интересы
	И1 = Справочники.ИнтересКлиента.СоздатьЭлемент(); И1.Наименование = "Бытовая техника"; И1.Записать();
	
	// Клиенты
	К1 = Справочники.Клиенты.СоздатьЭлемент(); К1.Наименование = "Иванов Иван"; К1.Записать();
	
	// 4 Сделки по ТЗ
	С1 = Справочники.Сделки.СоздатьЭлемент();
	С1.Наименование = "Продажа холодильника (Выиграна)";
	С1.Клиент = К1.Ссылка; С1.Статус = Перечисления.СтатусыСделок.Выиграна; С1.ТекущийЭтап = Перечисления.ЭтапыСделки.Продажа;
	С1.Записать();
	
	С2 = Справочники.Сделки.СоздатьЭлемент();
	С2.Наименование = "Заказ на стиралку (В заказе)";
	С2.Клиент = К1.Ссылка; С2.Статус = Перечисления.СтатусыСделок.ВРаботе; С2.ТекущийЭтап = Перечисления.ЭтапыСделки.ВыставленСчет;
	С2.Записать();
	
	С3 = Справочники.Сделки.СоздатьЭлемент();
	С3.Наименование = "Интерес к СВЧ (В КП)";
	С3.Клиент = К1.Ссылка; С3.Статус = Перечисления.СтатусыСделок.ВРаботе; С3.ТекущийЭтап = Перечисления.ЭтапыСделки.КоммерческоеПредложение;
	С3.Записать();
	
	С4 = Справочники.Сделки.СоздатьЭлемент();
	С4.Наименование = "Отказ от покупки (Проиграна)";
	С4.Клиент = К1.Ссылка; С4.Статус = Перечисления.СтатусыСделок.Проиграна; С4.ПричинаПроигрыша = Справочники.ПричиныПроигрыша.ВысокаяЦена;
	С4.ТекущийЭтап = Перечисления.ЭтапыСделки.КоммерческоеПредложение;
	С4.Записать();
	
	
	// ----- Z3 Test Data -----
	ВМ1 = Справочники.ВидыМероприятий.СоздатьЭлемент(); ВМ1.Наименование = "Выставка"; ВМ1.Записать();
	ВМ2 = Справочники.ВидыМероприятий.СоздатьЭлемент(); ВМ2.Наименование = "Семинар"; ВМ2.Записать();

	ВА1 = Справочники.ВидыАктивностей.СоздатьЭлемент(); ВА1.Наименование = "Рассылка"; ВА1.ТипАктивности = Перечисления.ТипыАктивностей.Онлайн; ВА1.Записать();
	ВА2 = Справочники.ВидыАктивностей.СоздатьЭлемент(); ВА2.Наименование = "Соцсети"; ВА2.ТипАктивности = Перечисления.ТипыАктивностей.Онлайн; ВА2.Записать();
	ВА3 = Справочники.ВидыАктивностей.СоздатьЭлемент(); ВА3.Наименование = "Прозвон"; ВА3.ТипАктивности = Перечисления.ТипыАктивностей.Офлайн; ВА3.Записать();

	М1 = Документы.МаркетинговоеМероприятие.СоздатьДокумент(); М1.Дата = ТекущаяДатаСеанса(); М1.Название = "Выставка инноваций"; М1.ВидМероприятия = ВМ1.Ссылка; М1.ДатаНачала = ТекущаяДатаСеанса() + 86400; М1.ДатаОкончания = ТекущаяДатаСеанса() + 86400*2; М1.Бюджет = 100000; М1.КоличествоУчастников = 500; М1.Напомнить = Истина; М1.ДатаВремяНапоминания = М1.ДатаНачала - 3600; М1.Записать(РежимЗаписиДокумента.Проведение);
	М2 = Документы.МаркетинговоеМероприятие.СоздатьДокумент(); М2.Дата = ТекущаяДатаСеанса(); М2.Название = "Семинар по продажам"; М2.ВидМероприятия = ВМ2.Ссылка; М2.ДатаНачала = ТекущаяДатаСеанса() + 86400*5; М2.ДатаОкончания = ТекущаяДатаСеанса() + 86400*6; М2.Бюджет = 20000; М2.КоличествоУчастников = 50; М2.Записать(РежимЗаписиДокумента.Проведение);

	А1 = Документы.МаркетинговаяАктивность.СоздатьДокумент(); А1.Дата = ТекущаяДатаСеанса(); А1.Название = "Рассылка клиентам"; А1.ВидАктивности = ВА1.Ссылка; А1.ТипАктивности = ВА1.ТипАктивности; А1.ДатаНачала = ТекущаяДатаСеанса() + 3600; А1.ДатаОкончания = ТекущаяДатаСеанса() + 7200; А1.ПланируемыйБюджет = 5000; А1.Записать(РежимЗаписиДокумента.Проведение);
	А2 = Документы.МаркетинговаяАктивность.СоздатьДокумент(); А2.Дата = ТекущаяДатаСеанса(); А2.Название = "Реклама в соцсетях"; А2.ВидАктивности = ВА2.Ссылка; А2.ТипАктивности = ВА2.ТипАктивности; А2.ДатаНачала = ТекущаяДатаСеанса() + 86400*2; А2.ДатаОкончания = ТекущаяДатаСеанса() + 86400*10; А2.ПланируемыйБюджет = 50000; А2.Записать(РежимЗаписиДокумента.Проведение);
	А3 = Документы.МаркетинговаяАктивность.СоздатьДокумент(); А3.Дата = ТекущаяДатаСеанса(); А3.Название = "Прозвон базы"; А3.ВидАктивности = ВА3.Ссылка; А3.ТипАктивности = ВА3.ТипАктивности; А3.ДатаНачала = ТекущаяДатаСеанса() + 86400*3; А3.ДатаОкончания = ТекущаяДатаСеанса() + 86400*4; А3.ПланируемыйБюджет = 10000; А3.Напомнить = Истина; А3.ДатаВремяНапоминания = А3.ДатаНачала - 3600; А3.Записать(РежимЗаписиДокумента.Проведение);
	А4 = Документы.МаркетинговаяАктивность.СоздатьДокумент(); А4.Дата = ТекущаяДатаСеанса() - 86400*5; А4.Название = "Старая акция (просрочена)"; А4.ВидАктивности = ВА1.Ссылка; А4.ТипАктивности = ВА1.ТипАктивности; А4.ДатаНачала = ТекущаяДатаСеанса() - 86400*3; А4.ДатаОкончания = ТекущаяДатаСеанса() - 86400*2; А4.ПланируемыйБюджет = 15000; А4.Выполнено = Ложь; А4.Записать(РежимЗаписиДокумента.Проведение);

	Сообщить("Тестовые данные успешно созданы!");
КонецПроцедуры

&НаКлиенте
Процедура Заполнить(Команда)
	ЗаполнитьДанныеНаСервере();
КонецПроцедуры
