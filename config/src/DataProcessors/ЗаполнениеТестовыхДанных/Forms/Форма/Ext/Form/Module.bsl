&НаСервере
Функция НайтиИлиСоздатьКлиента(НаименованиеКлиента, ИсточникСсылка, ТелефонСтр, EmailСтр)

	Найденный = Справочники.Клиенты.НайтиПоНаименованию(НаименованиеКлиента, Истина);
	Если ЗначениеЗаполнено(Найденный) Тогда
		Возврат Найденный;
	КонецЕсли;

	Кл = Справочники.Клиенты.СоздатьЭлемент();
	Кл.Наименование = НаименованиеКлиента;
	Кл.ИсточникПоявления = ИсточникСсылка;
	Кл.Телефон = ТелефонСтр;
	Кл.Email = EmailСтр;
	СтрТел = Кл.Контакты.Добавить();
	СтрТел.Тип = Перечисления.ТипыКонтакта.Телефон;
	СтрТел.Значение = ТелефонСтр;
	СтрПочта = Кл.Контакты.Добавить();
	СтрПочта.Тип = Перечисления.ТипыКонтакта.Email;
	СтрПочта.Значение = EmailСтр;
	Кл.Записать();
	Возврат Кл.Ссылка;

КонецФункции

&НаСервере
Функция НайтиИлиСоздатьТовар(НаименованиеТовара, ЕдИзм, ЦенаТовара)

	Найденный = Справочники.Товары.НайтиПоНаименованию(НаименованиеТовара, Истина);
	Если ЗначениеЗаполнено(Найденный) Тогда
		Возврат Найденный;
	КонецЕсли;

	Тов = Справочники.Товары.СоздатьЭлемент();
	Тов.Наименование = НаименованиеТовара;
	Тов.ЕдиницаИзмерения = ЕдИзм;
	Тов.Цена = ЦенаТовара;
	Тов.Записать();
	Возврат Тов.Ссылка;

КонецФункции

&НаСервере
Процедура НастроитьТипыВидовАктивностей()

	ОнлайнВиды = Новый Массив;
	ОнлайнВиды.Добавить(Справочники.ВидыАктивностей.EmailРассылка);
	ОнлайнВиды.Добавить(Справочники.ВидыАктивностей.КонтекстнаяРеклама);
	ОнлайнВиды.Добавить(Справочники.ВидыАктивностей.ПродвижениеВСоцсетях);
	ОнлайнВиды.Добавить(Справочники.ВидыАктивностей.ПроведениеВебинара);
	ОнлайнВиды.Добавить(Справочники.ВидыАктивностей.ПубликацияСтатьиНаСайте);

	Для Каждого ВидСс Из ОнлайнВиды Цикл
		Если ВидСс.ТипАктивности <> Перечисления.ТипыАктивности.Онлайн Тогда
			Об = ВидСс.ПолучитьОбъект();
			Об.ТипАктивности = Перечисления.ТипыАктивности.Онлайн;
			Об.Записать();
		КонецЕсли;
	КонецЦикла;

	ОфлайнВиды = Новый Массив;
	ОфлайнВиды.Добавить(Справочники.ВидыАктивностей.РаздачаЛистовок);
	ОфлайнВиды.Добавить(Справочники.ВидыАктивностей.НаружнаяРеклама);
	ОфлайнВиды.Добавить(Справочники.ВидыАктивностей.УчастиеВВыставкеСтенд);
	ОфлайнВиды.Добавить(Справочники.ВидыАктивностей.ЛичнаяПрезентацияВОфисе);
	ОфлайнВиды.Добавить(Справочники.ВидыАктивностей.ХолодныйОбзвонПоБазе);

	Для Каждого ВидСс Из ОфлайнВиды Цикл
		Если ВидСс.ТипАктивности <> Перечисления.ТипыАктивности.Офлайн Тогда
			Об = ВидСс.ПолучитьОбъект();
			Об.ТипАктивности = Перечисления.ТипыАктивности.Офлайн;
			Об.Записать();
		КонецЕсли;
	КонецЦикла;

