&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Параметры.Свойство("ТолькоНаступившие") И Параметры.ТолькоНаступившие Тогда
		ПоказыватьВсеЗапланированные = Ложь;
	Иначе
		ПоказыватьВсеЗапланированные = Истина;
	КонецЕсли;

	ЗагрузитьСписокНапоминанийНаСервере();

КонецПроцедуры

&НаСервере
Процедура ЗагрузитьСписокНапоминанийНаСервере()

	СписокНапоминаний.Очистить();
	МассивНапоминаний = НапоминанияМаркетингаВызовСервера.ПолучитьАктуальныеНапоминания(НЕ ПоказыватьВсеЗапланированные);
	Для Каждого Эл Из МассивНапоминаний Цикл
		Стр = СписокНапоминаний.Добавить();
		ЗаполнитьЗначенияСвойств(Стр, Эл);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ПоказыватьВсеЗапланированныеПриИзменении(Элемент)

	ЗагрузитьСписокНапоминанийНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСписок(Команда)

	ЗагрузитьСписокНапоминанийНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура СписокНапоминанийВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ОткрытьТекущийДокумент();

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьКарточку(Команда)

	ОткрытьТекущийДокумент();

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьТекущийДокумент()

	ТекДанные = Элементы.СписокНапоминаний.ТекущиеДанные;
	Если ТекДанные <> Неопределено И ЗначениеЗаполнено(ТекДанные.ОбъектНапоминания) Тогда
		ПоказатьЗначение(, ТекДанные.ОбъектНапоминания);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПрекратитьНапоминание(Команда)

	ТекДанные = Элементы.СписокНапоминаний.ТекущиеДанные;
	Если ТекДанные <> Неопределено И ЗначениеЗаполнено(ТекДанные.ОбъектНапоминания) Тогда
		НапоминанияМаркетингаВызовСервера.ЗавершитьНапоминание(ТекДанные.ОбъектНапоминания);
		ЗагрузитьСписокНапоминанийНаСервере();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОтложитьНа15Минут(Команда)

	ТекДанные = Элементы.СписокНапоминаний.ТекущиеДанные;
	Если ТекДанные <> Неопределено И ЗначениеЗаполнено(ТекДанные.ОбъектНапоминания) Тогда
		НапоминанияМаркетингаВызовСервера.ОтложитьНапоминание(ТекДанные.ОбъектНапоминания, 15);
		ЗагрузитьСписокНапоминанийНаСервере();
	КонецЕсли;

КонецПроцедуры
