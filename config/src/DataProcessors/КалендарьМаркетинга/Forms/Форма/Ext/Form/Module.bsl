&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ТекДата = ТекущаяДатаСеанса();
	НачалоПериода = НачалоМесяца(ТекДата);
	ОкончаниеПериода = КонецМесяца(ТекДата);
	ПоказыватьМероприятия = Истина;
	ПоказыватьАктивности = Истина;

	ЗаполнитьКалендарьНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	// Автообновление календаря при работе пользователя
	ПодключитьОбработчикОжидания("АвтоОбновлениеКалендаря", 30);

КонецПроцедуры

&НаКлиенте
Процедура АвтоОбновлениеКалендаря()

	ЗаполнитьКалендарьНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)

	// Автоматически обновляем календарь после записи мероприятия или активности
	ЗаполнитьКалендарьНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ПериодПриИзменении(Элемент)

	ЗаполнитьКалендарьНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ФильтрПриИзменении(Элемент)

	ЗаполнитьКалендарьНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьКалендарь(Команда)

	ЗаполнитьКалендарьНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура СоздатьМероприятие(Команда)

	ОткрытьФорму("Документ.МаркетинговоеМероприятие.Форма.ФормаДокумента", , ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура СоздатьАктивность(Команда)

	ОткрытьФорму("Документ.МаркетинговаяАктивность.Форма.ФормаДокумента", , ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура ПланировщикВыбор(Элемент, ЭлементПланировщика, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	Если ЭлементПланировщика <> Неопределено И ЗначениеЗаполнено(ЭлементПланировщика.Значение) Тогда
		ПоказатьЗначение(, ЭлементПланировщика.Значение);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПланировщикПередНачаломРедактирования(Элемент, ЭлементПланировщика, Отказ)

	// Открываем карточку мероприятия или активности непосредственно из календаря
	Отказ = Истина;
	Если ЭлементПланировщика <> Неопределено И ЗначениеЗаполнено(ЭлементПланировщика.Значение) Тогда
		ПоказатьЗначение(, ЭлементПланировщика.Значение);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПланировщикПередНачаломБыстрогоРедактирования(Элемент, ЭлементПланировщика, Отказ)

	// При двойном щелчке открываем саму карточку мероприятия / активности вместо быстрого редактирования текста
	Отказ = Истина;
	Если ЭлементПланировщика <> Неопределено И ЗначениеЗаполнено(ЭлементПланировщика.Значение) Тогда
		ПоказатьЗначение(, ЭлементПланировщика.Значение);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьКалендарьНаСервере()

	Планировщик.Элементы.Очистить();

	ТекДатаСеанса = ТекущаяДатаСеанса();
	НачПер = ?(ЗначениеЗаполнено(НачалоПериода), НачалоДня(НачалоПериода), НачалоМесяца(ТекДатаСеанса));
	КонПер = ?(ЗначениеЗаполнено(ОкончаниеПериода), КонецДня(ОкончаниеПериода), КонецМесяца(ТекДатаСеанса));
	Если КонПер < НачПер Тогда
		КонПер = КонецДня(НачПер);
	КонецЕсли;

	Планировщик.НачалоПериодаОтображения = НачПер;
	Планировщик.ОкончаниеПериодаОтображения = КонПер;
	Планировщик.ПоказыватьТекущуюДату = Истина;
	Планировщик.ОтображениеВремениЭлементов = ОтображениеВремениЭлементовПланировщика.ВремяНачалаИОкончания;

	// Мягкие ненавязчивые пастельные оттенки по ТЗ (без резких ярких цветов):
	ЦветМероприятия = Новый Цвет(219, 234, 254);            // мягкий светло-голубой (#DBEAFE)
	ЦветВыполненнойАктивности = Новый Цвет(220, 252, 231);  // мягкий пастельно-зеленый (#DCFCE7)
	ЦветПлановойАктивности = Новый Цвет(254, 249, 195);     // мягкий светло-песочный (#FEF9C3)
	ЦветПросроченнойАктивности = Новый Цвет(255, 228, 230); // мягкий светло-розовый (#FFE4E6)

	// 1. Загружаем маркетинговые мероприятия за период
	Если ПоказыватьМероприятия Тогда
		ЗапросМер = Новый Запрос;
		ЗапросМер.Текст =
		"ВЫБРАТЬ
		|	Мер.Ссылка КАК Ссылка,
		|	Мер.Название КАК Название,
		|	Мер.ВидМероприятия КАК ВидМероприятия,
		|	Мер.ДатаНачала КАК ДатаНачала,
		|	Мер.ДатаОкончания КАК ДатаОкончания,
		|	Мер.КоличествоУчастников КАК КоличествоУчастников,
		|	Мер.ПланируемыйБюджет КАК ПланируемыйБюджет
		|ИЗ
		|	Документ.МаркетинговоеМероприятие КАК Мер
		|ГДЕ
		|	НЕ Мер.ПометкаУдаления
		|	И Мер.ДатаНачала <= &КонПер
		|	И Мер.ДатаОкончания >= &НачПер
		|УПОРЯДОЧИТЬ ПО
		|	Мер.ДатаНачала";
		ЗапросМер.УстановитьПараметр("НачПер", НачПер);
		ЗапросМер.УстановитьПараметр("КонПер", КонПер);

		ВыборкаМер = ЗапросМер.Выполнить().Выбрать();
		Пока ВыборкаМер.Следующий() Цикл
			ДНач = ВыборкаМер.ДатаНачала;
			ДКон = ?(ЗначениеЗаполнено(ВыборкаМер.ДатаОкончания) И ВыборкаМер.ДатаОкончания >= ДНач,
				ВыборкаМер.ДатаОкончания, ДНач + 3600);

			Эл = Планировщик.Элементы.Добавить(ДНач, ДКон);
			Эл.Значение = ВыборкаМер.Ссылка;
			Эл.Текст = "[Мероприятие] " + СокрЛП(ВыборкаМер.Название)
				+ " (" + Формат(ДНач, "ДФ=чч:мм") + "–" + Формат(ДКон, "ДФ=чч:мм") + ")";
			Эл.Подсказка = "Маркетинговое мероприятие: " + СокрЛП(ВыборкаМер.Название)
				+ Символы.ПС + "Вид: " + Строка(ВыборкаМер.ВидМероприятия)
				+ Символы.ПС + "Начало: " + Формат(ДНач, "ДЛФ=DDT")
				+ Символы.ПС + "Окончание: " + Формат(ДКон, "ДЛФ=DDT")
				+ Символы.ПС + "Участников: " + Строка(ВыборкаМер.КоличествоУчастников)
				+ ", Бюджет: " + Строка(ВыборкаМер.ПланируемыйБюджет);
			Эл.ЦветФона = ЦветМероприятия;
		КонецЦикла;
	КонецЕсли;

	// 2. Загружаем маркетинговые активности за период
	Если ПоказыватьАктивности Тогда
		ЗапросАкт = Новый Запрос;
		ЗапросАкт.Текст =
		"ВЫБРАТЬ
		|	Акт.Ссылка КАК Ссылка,
		|	Акт.Название КАК Название,
		|	Акт.ТипАктивности КАК ТипАктивности,
		|	Акт.ВидАктивности КАК ВидАктивности,
		|	Акт.ДатаНачала КАК ДатаНачала,
		|	Акт.ДатаОкончания КАК ДатаОкончания,
		|	Акт.ПланируемыйБюджет КАК ПланируемыйБюджет,
		|	Акт.Выполнено КАК Выполнено
		|ИЗ
		|	Документ.МаркетинговаяАктивность КАК Акт
		|ГДЕ
		|	НЕ Акт.ПометкаУдаления
		|	И Акт.ДатаНачала <= &КонПер
		|	И Акт.ДатаОкончания >= &НачПер
		|УПОРЯДОЧИТЬ ПО
		|	Акт.ДатаНачала";
		ЗапросАкт.УстановитьПараметр("НачПер", НачПер);
		ЗапросАкт.УстановитьПараметр("КонПер", КонПер);

		ВыборкаАкт = ЗапросАкт.Выполнить().Выбрать();
		Пока ВыборкаАкт.Следующий() Цикл
			ДНач = ВыборкаАкт.ДатаНачала;
			ДКон = ?(ЗначениеЗаполнено(ВыборкаАкт.ДатаОкончания) И ВыборкаАкт.ДатаОкончания >= ДНач,
				ВыборкаАкт.ДатаОкончания, ДНач + 3600);

			Просрочена = (НЕ ВыборкаАкт.Выполнено) И (ДКон < ТекДатаСеанса);

			СтатусПрефикс = ?(ВыборкаАкт.Выполнено, "[Выполнено] ", ?(Просрочена, "[Просрочено] ", "[Активность] "));

			Эл = Планировщик.Элементы.Добавить(ДНач, ДКон);
			Эл.Значение = ВыборкаАкт.Ссылка;
			Эл.Текст = СтатусПрефикс + СокрЛП(ВыборкаАкт.Название)
				+ " (" + Формат(ДНач, "ДФ=чч:мм") + "–" + Формат(ДКон, "ДФ=чч:мм") + ")";
			Эл.Подсказка = "Маркетинговая активность: " + СокрЛП(ВыборкаАкт.Название)
				+ Символы.ПС + "Тип: " + Строка(ВыборкаАкт.ТипАктивности) + ", Вид: " + Строка(ВыборкаАкт.ВидАктивности)
				+ Символы.ПС + "Начало: " + Формат(ДНач, "ДЛФ=DDT")
				+ Символы.ПС + "Окончание: " + Формат(ДКон, "ДЛФ=DDT")
				+ Символы.ПС + "Статус: " + ?(ВыборкаАкт.Выполнено, "Выполнено", ?(Просрочена, "Не выполнено (просрочено)", "Запланировано"));

			Если ВыборкаАкт.Выполнено Тогда
				Эл.ЦветФона = ЦветВыполненнойАктивности;
			ИначеЕсли Просрочена Тогда
				// Невыполненные просроченные активности выделяются мягким светло-розовым цветом
				Эл.ЦветФона = ЦветПросроченнойАктивности;
			Иначе
				Эл.ЦветФона = ЦветПлановойАктивности;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры
