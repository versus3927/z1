&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Элементы.Календарь.ТекущаяДата = ТекущаяДатаСеанса();
	ОбновитьКалендарь();
КонецПроцедуры

&НаСервере
Процедура ОбновитьКалендарь()
	Календарь.Элементы.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ Ссылка, Название, ДатаНачала, ДатаОкончания ИЗ Документ.МаркетинговоеМероприятие ГДЕ НЕ ПометкаУдаления";
	Выб = Запрос.Выполнить().Выбрать();
	Пока Выб.Следующий() Цикл
		Эл = Календарь.Элементы.Добавить(Выб.ДатаНачала, Выб.ДатаОкончания);
		Эл.Текст = Выб.Название;
		Эл.Значение = Выб.Ссылка;
	КонецЦикла;
	
	Запрос.Текст = "ВЫБРАТЬ Ссылка, Название, ДатаНачала, ДатаОкончания, Выполнено ИЗ Документ.МаркетинговаяАктивность ГДЕ НЕ ПометкаУдаления";
	Выб = Запрос.Выполнить().Выбрать();
	Пока Выб.Следующий() Цикл
		Эл = Календарь.Элементы.Добавить(Выб.ДатаНачала, Выб.ДатаОкончания);
		Эл.Текст = Выб.Название;
		Эл.Значение = Выб.Ссылка;
		Если Не Выб.Выполнено И Выб.ДатаОкончания < ТекущаяДатаСеанса() Тогда
			Эл.ЦветФона = WebЦвета.СветлоРозовый;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура Обновить(Команда)
	ОбновитьКалендарь();
КонецПроцедуры

&НаКлиенте
Процедура КалендарьВыбор(Элемент, ЗначениеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Если ТипЗнч(ЗначениеВыбора) = Тип("ЭлементПланировщика") И ЗначениеЗаполнено(ЗначениеВыбора.Значение) Тогда
		ОткрытьЗначение(ЗначениеВыбора.Значение);
	КонецЕсли;
КонецПроцедуры
