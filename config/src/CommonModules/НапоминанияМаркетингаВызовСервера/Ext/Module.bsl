// Возвращает массив структур по наступившим или всем активным напоминаниям
// маркетинговых мероприятий и маркетинговых активностей.
Функция ПолучитьАктуальныеНапоминания(ТолькоНаступившие = Истина) Экспорт

	Результат = Новый Массив;
	ТекМомент = ТекущаяДатаСеанса();

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Мер.Ссылка КАК ОбъектНапоминания,
	|	""Маркетинговое мероприятие"" КАК ВидОбъекта,
	|	Мер.Название КАК Название,
	|	Мер.ДатаНачала КАК ДатаНачала,
	|	Мер.ДатаВремяНапоминания КАК ДатаВремяНапоминания
	|ИЗ
	|	Документ.МаркетинговоеМероприятие КАК Мер
	|ГДЕ
	|	НЕ Мер.ПометкаУдаления
	|	И Мер.Напомнить
	|	И НЕ Мер.НапоминаниеВыполнено
	|	И Мер.ДатаВремяНапоминания <> ДАТАВРЕМЯ(1, 1, 1)
	|	И (НЕ &ТолькоНаступившие ИЛИ Мер.ДатаВремяНапоминания <= &ТекМомент)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Акт.Ссылка КАК ОбъектНапоминания,
	|	""Маркетинговая активность"" КАК ВидОбъекта,
	|	Акт.Название КАК Название,
	|	Акт.ДатаНачала КАК ДатаНачала,
	|	Акт.ДатаВремяНапоминания КАК ДатаВремяНапоминания
	|ИЗ
	|	Документ.МаркетинговаяАктивность КАК Акт
	|ГДЕ
	|	НЕ Акт.ПометкаУдаления
	|	И Акт.Напомнить
	|	И НЕ Акт.НапоминаниеВыполнено
	|	И НЕ Акт.Выполнено
	|	И Акт.ДатаВремяНапоминания <> ДАТАВРЕМЯ(1, 1, 1)
	|	И (НЕ &ТолькоНаступившие ИЛИ Акт.ДатаВремяНапоминания <= &ТекМомент)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаВремяНапоминания";

	Запрос.УстановитьПараметр("ТолькоНаступившие", ТолькоНаступившие);
	Запрос.УстановитьПараметр("ТекМомент", ТекМомент);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Элемент = Новый Структура;
		Элемент.Вставить("ОбъектНапоминания", Выборка.ОбъектНапоминания);
		Элемент.Вставить("ВидОбъекта", Выборка.ВидОбъекта);
		Элемент.Вставить("Название", Выборка.Название);
		Элемент.Вставить("ДатаНачала", Выборка.ДатаНачала);
		Элемент.Вставить("ДатаВремяНапоминания", Выборка.ДатаВремяНапоминания);
		Результат.Добавить(Элемент);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Отмечает напоминание выполненным (прекращает повторные напоминания)
Процедура ЗавершитьНапоминание(СсылкаНаДокумент) Экспорт

	Если НЕ ЗначениеЗаполнено(СсылкаНаДокумент) Тогда
		Возврат;
	КонецЕсли;

	ОбъектДок = СсылкаНаДокумент.ПолучитьОбъект();
	Если ОбъектДок <> Неопределено Тогда
		ОбъектДок.НапоминаниеВыполнено = Истина;
		ОбъектДок.ОбменДанными.Загрузка = Истина;
		ОбъектДок.Записать();
	КонецЕсли;

КонецПроцедуры

// Переносит напоминание на указанное число минут вперед
Процедура ОтложитьНапоминание(СсылкаНаДокумент, МинутОтложить = 15) Экспорт

	Если НЕ ЗначениеЗаполнено(СсылкаНаДокумент) Тогда
		Возврат;
	КонецЕсли;

	ОбъектДок = СсылкаНаДокумент.ПолучитьОбъект();
	Если ОбъектДок <> Неопределено Тогда
		ОбъектДок.Напомнить = Истина;
		ОбъектДок.НапоминаниеВыполнено = Ложь;
		ОбъектДок.ДатаВремяНапоминания = ТекущаяДатаСеанса() + МинутОтложить * 60;
		ОбъектДок.ОбменДанными.Загрузка = Истина;
		ОбъектДок.Записать();
	КонецЕсли;

КонецПроцедуры
