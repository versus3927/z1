// Напоминания о взаимодействиях с клиентами (Задание 1, 13 баллов).
//
// Менеджер ставит флажок «Напомнить» и указывает дату и время. В назначенный
// момент клиентское приложение (см. ОбщийМодульПовтИсп «ПриНачалеРаботыСистемы»)
// получает список наступивших напоминаний и выводит оповещение с клиентом и
// видом взаимодействия; по нажатию открывается карточка взаимодействия.

// Возвращает массив структур с наступившими (или всеми активными) напоминаниями.
Функция ПолучитьАктуальныеНапоминания(ТолькоНаступившие = Истина) Экспорт

	Результат = Новый Массив;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Вз.Ссылка КАК ОбъектНапоминания,
		|	Вз.Клиент КАК Клиент,
		|	Вз.ВидВзаимодействия КАК ВидВзаимодействия,
		|	Вз.КраткоеСодержание КАК КраткоеСодержание,
		|	Вз.Дата КАК Дата,
		|	Вз.ДатаВремяНапоминания КАК ДатаВремяНапоминания,
		|	Вз.Напомнить КАК Напомнить,
		|	Вз.НапоминаниеВыполнено КАК НапоминаниеВыполнено
		|ИЗ
		|	Документ.Взаимодействие КАК Вз
		|ГДЕ
		|	НЕ Вз.ПометкаУдаления
		|	И Вз.Напомнить
		|	И НЕ Вз.НапоминаниеВыполнено
		|	И Вз.ДатаВремяНапоминания <> ДАТАВРЕМЯ(1, 1, 1)
		|	И (НЕ &ТолькоНаступившие ИЛИ Вз.ДатаВремяНапоминания <= &ТекМомент)
		|УПОРЯДОЧИТЬ ПО
		|	ДатаВремяНапоминания";

	Запрос.УстановитьПараметр("ТолькоНаступившие", ТолькоНаступившие);
	Запрос.УстановитьПараметр("ТекМомент", ТекущаяДатаСеанса());

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Элемент = Новый Структура;
		Элемент.Вставить("ОбъектНапоминания", Выборка.ОбъектНапоминания);
		Элемент.Вставить("Клиент", Выборка.Клиент);
		Элемент.Вставить("ВидВзаимодействия", Выборка.ВидВзаимодействия);
		Элемент.Вставить("КраткоеСодержание", Выборка.КраткоеСодержание);
		Элемент.Вставить("Дата", Выборка.Дата);
		Элемент.Вставить("ДатаВремяНапоминания", Выборка.ДатаВремяНапоминания);
		Результат.Добавить(Элемент);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Текст оповещения: клиент и вид взаимодействия (как требует ТЗ).
Функция ТекстНапоминания(Напоминание) Экспорт

	Возврат "Взаимодействие: " + СокрЛП(Строка(Напоминание.Клиент))
		+ " — " + СокрЛП(Строка(Напоминание.ВидВзаимодействия))
		+ " (" + Формат(Напоминание.Дата, "ДЛФ=DDT") + ")";

КонецФункции

// Отмечает напоминание выполненным, чтобы оно не повторялось.
Процедура ЗавершитьНапоминание(СсылкаНаВзаимодействие) Экспорт

	Если НЕ ЗначениеЗаполнено(СсылкаНаВзаимодействие) Тогда
		Возврат;
	КонецЕсли;

	ОбъектДок = СсылкаНаВзаимодействие.ПолучитьОбъект();
	Если ОбъектДок <> Неопределено Тогда
		ОбъектДок.НапоминаниеВыполнено = Истина;
		ОбъектДок.Напомнить = Ложь;
		ОбъектДок.ОбменДанными.Загрузка = Истина;
		ОбъектДок.Записать();
	КонецЕсли;

КонецПроцедуры

// Откладывает напоминание на указанное число минут.
Процедура ОтложитьНапоминание(СсылкаНаВзаимодействие, МинутОтложить = 15) Экспорт

	Если НЕ ЗначениеЗаполнено(СсылкаНаВзаимодействие) Тогда
		Возврат;
	КонецЕсли;

	ОбъектДок = СсылкаНаВзаимодействие.ПолучитьОбъект();
	Если ОбъектДок <> Неопределено Тогда
		ОбъектДок.Напомнить = Истина;
		ОбъектДок.НапоминаниеВыполнено = Ложь;
		ОбъектДок.ДатаВремяНапоминания = ТекущаяДатаСеанса() + МинутОтложить * 60;
		ОбъектДок.ОбменДанными.Загрузка = Истина;
		ОбъектДок.Записать();
	КонецЕсли;

КонецПроцедуры
